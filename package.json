{
  "name": "embla-a11y",
  "version": "0.0.0",
  "description": "Accessibility plugin for Embla Carousel 8.6 and 9. Keeps visible slides readable, puts users in control of motion, targets WCAG 2.2 AA.",
  "keywords": [
    "embla",
    "embla-carousel",
    "carousel",
    "slider",
    "accessibility",
    "a11y",
    "aria",
    "wcag"
  ],
  "license": "MIT",
  "author": "Wolfgang Klinger <wolfgang@wazum.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wazum/embla-a11y.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "html": "html-validate 'e2e/pages/**/*.html' 'examples/*.html' 'demo/*.html'",
    "actionlint": "docker run --rm -v \"$PWD:/repo\" -w /repo rhysd/actionlint:1.7.12 -color",
    "knip": "knip",
    "package:check": "npm run build && publint --strict && attw --pack --profile esm-only && tsc -p v8",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run html && npm run knip && npm run package:check",
    "package:install": "bash scripts/install-test.sh",
    "browsers": "docker compose up -d --wait playwright",
    "browsers:stop": "docker compose down",
    "test": "npm run browsers && vitest run",
    "test:watch": "npm run browsers && vitest",
    "test:e2e": "npm run browsers && playwright test --reporter=list",
    "test:v8": "EMBLA=8 npm test",
    "test:e2e:v8": "EMBLA=8 npm run test:e2e",
    "test:screenreader": "playwright test -c playwright.screenreader.config.ts --reporter=list",
    "demo": "vite",
    "site": "vite -c vite.demo.config.ts",
    "site:v8": "EMBLA=8 vite -c vite.demo.config.ts",
    "site:build": "vite build -c vite.demo.config.ts && EMBLA=8 vite build -c vite.demo.config.ts",
    "site:preview": "vite preview -c vite.demo.config.ts"
  },
  "peerDependencies": {
    "embla-carousel": "^8.6.0 || ^9.0.0-rc04"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.14.0",
    "@guidepup/guidepup": "0.36.4",
    "@guidepup/playwright": "0.20.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vitest/browser-playwright": "5.0.5",
    "embla-carousel": "9.0.0-rc04",
    "embla-carousel-auto-scroll": "9.0.0-rc04",
    "embla-carousel-autoplay": "9.0.0-rc04",
    "embla-carousel-fade": "9.0.0-rc04",
    "html-validate": "11.16.4",
    "knip": "6.42.0",
    "lefthook": "2.2.2",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "sass": "1.105.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
