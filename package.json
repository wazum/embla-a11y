{
  "name": "embla-carousel-a11y",
  "version": "0.0.0",
  "description": "Accessibility plugin for Embla Carousel v9. Keeps visible slides readable, puts users in control of motion, targets WCAG 2.2 AA.",
  "keywords": [
    "embla",
    "embla-carousel",
    "carousel",
    "slider",
    "accessibility",
    "a11y",
    "aria",
    "wcag"
  ],
  "license": "MIT",
  "author": "Wolfgang Klinger <wk@plan2.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wazum/embla-carousel-a11y.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "html": "html-validate 'e2e/pages/**/*.html'",
    "actionlint": "docker run --rm -v \"$PWD:/repo\" -w /repo rhysd/actionlint:1.7.12 -color",
    "knip": "knip",
    "package:check": "npm run build && publint --strict && attw --pack --profile esm-only",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run html && npm run knip && npm run package:check",
    "browsers": "docker compose up -d --wait playwright",
    "browsers:stop": "docker compose down",
    "test": "npm run browsers && vitest run",
    "test:watch": "npm run browsers && vitest",
    "test:e2e": "npm run browsers && playwright test --reporter=list",
    "test:screenreader": "playwright test -c playwright.screenreader.config.ts --reporter=list",
    "demo": "vite"
  },
  "peerDependencies": {
    "embla-carousel": "^9.0.0-rc04"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.14.0",
    "@guidepup/guidepup": "0.36.4",
    "@guidepup/playwright": "0.20.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vitest/browser-playwright": "5.0.5",
    "embla-carousel": "9.0.0-rc04",
    "embla-carousel-fade": "9.0.0-rc04",
    "html-validate": "11.16.4",
    "knip": "6.42.0",
    "lefthook": "2.2.2",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
